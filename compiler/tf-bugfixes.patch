   $48 c, $99 c,                  \ cqo
-  $48 c, $f7 c, $f9 c,           \ idiv rcx
+  $48 c, $f7 c, $ff c,           \ idiv rdi
   $48 c, $89 c, $d0 c,           \ mov rax, rdx       ; result = remainder
