+  \ idiv uses rdx:rax / operand. Use rdi as divisor to avoid rcx (stack reg)
+  stack-depth @ 3 >= if $51 c, then  \ push rcx if live
+  $48 c, $89 c, $c7 c,           \ mov rdi, rax       ; divisor = b
   $48 c, $89 c, $d8 c,           \ mov rax, rbx       ; dividend = a
